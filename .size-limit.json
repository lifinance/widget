      "packages/widget-provider-stellar/dist/esm/index.js": "{ StellarProvider }",
      "packages/widget-provider-zcash/dist/esm/index.js": "{ ZcashProvider }"
    },
    "ignore": ["react", "react-dom", "@tanstack/react-query"],
    "limit": "2292 kB"
  }
]
