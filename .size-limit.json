    "ignore": ["react", "@lifi/sdk", "@lifi/widget-provider"],
    "limit": "213 kB"
  },
  {
    "name": "Providers · zcash",
    "path": "packages/widget-provider-zcash/dist/esm/index.js",
    "import": "{ ZcashProvider }",
    "ignore": ["react", "@lifi/sdk", "@lifi/widget-provider"],
    "limit": "8 kB"
  },
  {
    "name": "Full integration · LiFiWidget + all providers + their peers (incl. on-demand code)",
    "import": {
      "packages/widget/dist/esm/index.js": "{ LiFiWidget }",
      "packages/widget-provider-ethereum/dist/esm/index.js": "{ EthereumProvider }",
      "packages/widget-provider-solana/dist/esm/index.js": "{ SolanaProvider }",
